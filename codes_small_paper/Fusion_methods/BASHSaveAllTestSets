for perc in 1
do
	for sbj in 23 #{7,11,15,19,23}
	do

		CUDA_VISIBLE_DEVICES=2 matlab -nodisplay -nojvm -r 'saveTestSet('$sbj','$perc'); quit' | tail -n +10
		
		for att in {0.7,0.9}
		do
			CUDA_VISIBLE_DEVICES=2 matlab -nodisplay -nojvm -r 'saveTestSet('$sbj','$perc','$att'); quit' | tail -n +10 
		done
		
		for snr in {1,0.5,0.1}
		do
			CUDA_VISIBLE_DEVICES=2 matlab -nodisplay -nojvm -r 'saveTestSet('$sbj','$perc',-1,'$snr'); quit' | tail -n +10 
		done

	done
done

